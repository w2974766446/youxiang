# ===== 选品台后台 - 管理员口令（仅本人可知，用于访问 /admin.html 汇总）=====
# 请务必修改为强口令
ADMIN_PASS=123123

# ===== 邮件自动发送配置（SMTP，必填才能自动发邮件）=====
# 达人每次提交选款后，系统会用自己的 SMTP 账号把选品表格自动发到“指定接收邮箱”。
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 选款提交后自动接收选品表格的邮箱
NOTIFY_EMAIL=wujiangluo@hmbpo.cn

# ===== 服务配置 =====
PORT=3000
# 库存低于该值标注为“紧张”（缺货=0）
LOW_STOCK_THRESHOLD=10

# ===== 选品表格本地输出目录 =====
# 达人每次提交后，选品表格（Excel + HTML 预览）会自动保存到该目录（相对项目根目录）。
# 例如可改为：OUTPUT_DIR=D:/xuankuan/选品导出
OUTPUT_DIR=data/exports
